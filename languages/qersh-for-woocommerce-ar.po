#. Plugin Name of the plugin
msgid "Qersh for WooCommerce"
msgstr "Qersh for WooCommerce"

#. Plugin URI of the plugin
msgid "https://qersh.cfd/en/integrations/woocommerce"
msgstr "https://qersh.cfd/integrations/woocommerce"

#. Description of the plugin
msgid "Confirms WooCommerce orders paid by e-wallet transfer, using the Qersh app on the phone that receives your wallet's messages."
msgstr "يؤكد طلبات WooCommerce المدفوعة بتحويل من محفظة إلكترونية، بتطبيق قرش على الهاتف الذي تصله رسائل محفظتك."

#. Author of the plugin
#: src/Admin/Module.php:154
#: src/Admin/Module.php:158
#: src/Admin/OrderBox.php:60
#: templates/admin/page.php:17
msgid "Qersh"
msgstr "قرش"

#. Author URI of the plugin
msgid "https://qersh.cfd/en/"
msgstr "https://qersh.cfd/"

#: src/Admin/Module.php:264
#: src/Admin/Module.php:490
msgid "Sorry, you are not allowed to manage this store."
msgstr "عذرًا، لا تملك صلاحية إدارة هذا المتجر."

#: src/Admin/Module.php:276
#: src/Admin/Module.php:358
msgid "Wallets"
msgstr "المحافظ"

#: src/Admin/Module.php:277
msgid "Transfers"
msgstr "التحويلات"

#: src/Admin/Module.php:278
msgid "Settings"
msgstr "الإعدادات"

#: src/Admin/Module.php:279
#: src/Admin/TransfersTable.php:72
msgid "Status"
msgstr "الحالة"

#. translators: 1: link to the app download page, 2: support email address.
#: src/Admin/Module.php:303
#: src/Gateway.php:85
#, php-format
msgid "Works with the paid Qersh Android app (monthly subscription) on the phone that receives your wallet's messages. Get the app: %1$s. Support: the plugin's forum on wordpress.org or %2$s."
msgstr "تعمل مع تطبيق قرش المدفوع (اشتراك شهري) على الهاتف الذي تصله رسائل محفظتك. احصل على التطبيق: %1$s. الدعم: منتدى الإضافة على wordpress.org أو %2$s."

#: src/Admin/Module.php:391
msgid "Open Qersh"
msgstr "افتح قرش"

#: src/Admin/Module.php:393
msgid "Qersh:"
msgstr "قرش:"

#. translators: %s: WooCommerce version number.
#: src/Admin/Module.php:466
#, php-format
msgid "Qersh for WooCommerce needs WooCommerce %s or later, active."
msgstr "تحتاج Qersh for WooCommerce إلى WooCommerce %s أو أحدث، مفعّلًا."

#: src/Admin/Module.php:487
msgid "This action needs a form submission."
msgstr "يحتاج هذا الإجراء إلى إرسال نموذج."

#: src/Admin/OrderBox.php:122
msgid "The wait for the transfer has not started yet. Send the customer the payment page (Order actions → “Send order details to customer”) so they enter the number they will transfer from, or attach their transfer from “Personal transfers” if they transferred before the order was created."
msgstr "لم يبدأ انتظار التحويل بعد. أرسل للعميل صفحة الدفع (إجراءات الطلب ← «إرسال تفاصيل الطلب إلى العميل») ليكتب الرقم الذي سيحوّل منه، أو ألحق تحويله من «تحويلات شخصية» إن كان قد حوّل قبل إنشاء الطلب."

#. translators: %s: wallet number or InstaPay address.
#: src/Admin/OrderBox.php:126
#, php-format
msgid "Payer number: %s"
msgstr "رقم الدافع: %s"

#. translators: 1: wallet name, 2: wallet number or address.
#: src/Admin/OrderBox.php:130
#, php-format
msgid "Wallet: %1$s (%2$s)"
msgstr "المحفظة: %1$s (%2$s)"

#. translators: %s: wallet id.
#: src/Admin/OrderBox.php:133
#, php-format
msgid "Wallet: %s (deleted)"
msgstr "المحفظة: %s (محذوفة)"

#. translators: %s: date and time.
#: src/Admin/OrderBox.php:137
#, php-format
msgid "Deadline: %s Cairo time"
msgstr "الموعد: %s بتوقيت القاهرة"

#. translators: 1: amount received, 2: order amount.
#: src/Admin/OrderBox.php:143
#: src/Emails/AdminAlert.php:240
#, php-format
msgid "Received: %1$s of %2$s"
msgstr "وصل: %1$s من %2$s"

#. translators: %s: date and time.
#: src/Admin/OrderBox.php:159
#: src/Admin/Wallets.php:166
#, php-format
msgid "Last delivery from this wallet's phone: %s"
msgstr "آخر ما وصل من هاتف هذه المحفظة: %s"

#: src/Admin/OrderBox.php:161
msgid "Nothing has arrived from this wallet's phone yet."
msgstr "لم يصل شيء من هاتف هذه المحفظة بعد."

#: src/Admin/OrderBox.php:210
msgid "No transfer with this transaction id has arrived yet"
msgstr "لم يصل تحويل بهذا الرقم بعد"

#. translators: %s: transfer id.
#: src/Admin/OrderBox.php:216
#, php-format
msgid "Matched transfer %s"
msgstr "طابق التحويل %s"

#. translators: %s: order number.
#: src/Admin/OrderBox.php:221
#, php-format
msgid "Already paid order %s"
msgstr "دفع الطلب %s من قبل"

#: src/Admin/OrderBox.php:224
#: src/Admin/OrderBox.php:248
msgid "Waits for your decision in “Needs a decision”"
msgstr "ينتظر قرارك في «تحتاج قرارًا»"

#. translators: 1: transaction id, 2: date and time, 3: what became of it.
#: src/Admin/OrderBox.php:230
#, php-format
msgid "Transaction id from the customer: %1$s (%2$s) · %3$s"
msgstr "رقم العملية من العميل: %1$s (%2$s) · %3$s"

#: src/Admin/OrderBox.php:242
msgid "Waiting for the transfer"
msgstr "بانتظار التحويل"

#: src/Admin/OrderBox.php:244
msgid "Part of the amount arrived"
msgstr "وصل جزء من المبلغ"

#: src/Admin/OrderBox.php:246
msgid "Paid by wallet transfer"
msgstr "مدفوع بتحويل محفظة"

#: src/Admin/OrderBox.php:250
msgid "The transfer window ended"
msgstr "انتهت مهلة التحويل"

#: src/Admin/OrderBox.php:252
msgid "Closed"
msgstr "مغلق"

#: src/Admin/Reasons.php:327
msgid "Qersh has not confirmed the wallet balance yet: confirm your balance with “Sync balance” on the phone."
msgstr "قرش لم يتأكد من رصيد المحفظة بعد: أكّد رصيدك في «مزامنة الرصيد» على الهاتف."

#: src/Admin/Reasons.php:329
msgid "Larger than the “Auto-confirm limit (EGP)” in the wallet settings on the phone."
msgstr "أكبر من «الحد الأقصى للتأكيد التلقائي (جنيه)» في إعدادات المحفظة على الهاتف."

#. translators: %s: risk reason code.
#: src/Admin/Reasons.php:334
#: src/Admin/Reasons.php:405
#, php-format
msgid "Qersh did not confirm this transfer on its own (%s): check that the money arrived in the wallet app."
msgstr "لم يؤكد قرش هذا التحويل وحده (%s): تأكد من وصول المال في تطبيق المحفظة."

#: src/Admin/Reasons.php:336
#: src/Admin/Reasons.php:339
msgid "An InstaPay notification alone, with no bank message to confirm it; check that the money arrived in the InstaPay app."
msgstr "إشعار إنستاباي وحده بلا رسالة بنك تؤكده؛ تأكد من وصول المال في تطبيق إنستاباي."

#: src/Admin/Reasons.php:341
msgid "This message does not state the balance, so Qersh cannot check it: check that the money arrived in the bank or wallet app."
msgstr "هذه الرسالة لا تذكر الرصيد، فلا يستطيع قرش فحصها: تأكد من وصول المال في تطبيق البنك أو المحفظة."

#: src/Admin/Reasons.php:345
msgid "Qersh reads this message with a template that is not fully verified yet: check that the money arrived in the bank or wallet app."
msgstr "يقرأ قرش هذه الرسالة بقالب لم يُتحقَّق منه كاملًا بعد: تأكد من وصول المال في تطبيق البنك أو المحفظة."

#: src/Admin/Reasons.php:348
msgid "The message does not name the payer's number, and no customer has entered this transaction id yet."
msgstr "الرسالة لا تذكر رقم الدافع، ولم يكتب أي عميل رقم هذه العملية بعد."

#: src/Admin/Reasons.php:350
msgid "The message does not name the payer's number."
msgstr "الرسالة لا تذكر رقم الدافع."

#: src/Admin/Reasons.php:352
msgid "The payer's number arrived masked; set “Send sender details” to “Full name and number”."
msgstr "وصل رقم الدافع مقنَّعًا؛ اجعل «إرسال بيانات المُرسِل» على «الاسم والرقم كاملين»."

#. translators: %s: transfer id.
#: src/Admin/Reasons.php:355
#, php-format
msgid "Duplicate transaction id: it came before in transfer %s."
msgstr "رقم عملية مكرر: ورد من قبل في التحويل %s."

#: src/Admin/Reasons.php:358
msgid "Arrived after the payer's order was closed."
msgstr "وصل بعد إغلاق طلب الدافع."

#. translators: %s: order number.
#: src/Admin/Reasons.php:361
#, php-format
msgid "Arrived after order %s was closed."
msgstr "وصل بعد إغلاق الطلب %s."

#. translators: %s: order number.
#: src/Admin/Reasons.php:364
#, php-format
msgid "There is not enough stock to bring back order %s."
msgstr "المخزون لا يكفي لإحياء الطلب %s."

#: src/Admin/Reasons.php:366
msgid "Part of the amount arrived, and the rest did not arrive before the deadline."
msgstr "وصل جزء من المبلغ ولم يصل الباقي قبل الموعد."

#. translators: %s: order number.
#: src/Admin/Reasons.php:369
#: src/Emails/AdminAlert.php:227
#, php-format
msgid "The customer of order %s entered this transaction id, and its deadline came before your decision; the order is on hold until you decide."
msgstr "كتب عميل الطلب %s رقم هذه العملية وحلّ موعده قبل قرارك؛ فيبقى الطلب على حاله حتى تقرر."

#. translators: 1: order number, 2: order number.
#: src/Admin/Reasons.php:373
#, php-format
msgid "This transaction id was entered on orders %1$s and %2$s."
msgstr "كُتب رقم العملية هذا على الطلبين %1$s و%2$s."

#. translators: 1: order number, 2: order number.
#: src/Admin/Reasons.php:376
#, php-format
msgid "The customer of order %1$s entered this transaction id, but order %2$s waits for the same amount on this wallet. Check the payer's name in the wallet app before you attach it."
msgstr "كتب عميل الطلب %1$s رقم العملية هذا، لكن الطلب %2$s ينتظر المبلغ نفسه على هذه المحفظة. راجع اسم الدافع في تطبيق المحفظة قبل أن تُلحقه."

#. translators: 1: order number, 2: amount.
#: src/Admin/Reasons.php:379
#, php-format
msgid "The customer of order %1$s entered this transaction id, but the amount differs from what is left to pay on the order (%2$s)."
msgstr "كتب عميل الطلب %1$s رقم العملية هذا، لكن المبلغ يخالف باقي الطلب (%2$s)."

#. translators: %s: order number.
#: src/Admin/Reasons.php:383
#, php-format
msgid "The transaction id was entered on order %s before the operator sent the message of this transfer."
msgstr "كُتب رقم العملية على الطلب %s قبل أن يرسل المشغّل رسالة هذا التحويل."

#. translators: %s: order number.
#: src/Admin/Reasons.php:386
#, php-format
msgid "The customer of order %s entered this transaction id, but the money arrived before the order was created, or outside its time."
msgstr "كتب عميل الطلب %s رقم العملية هذا، لكن المال وصل قبل إنشاء الطلب أو خارج وقته."

#. translators: 1: order number, 2: wallet name.
#: src/Admin/Reasons.php:389
#, php-format
msgid "The customer of order %1$s entered this transaction id, but chose the wallet %2$s."
msgstr "كتب عميل الطلب %1$s رقم العملية هذا، لكنه اختار المحفظة %2$s."

#: src/Admin/Reasons.php:391
msgid "This transfer's message is suspected to be forged."
msgstr "يُشتبه أن رسالة هذا التحويل مزوّرة."

#: src/Admin/Reasons.php:393
msgid "You confirmed the balance on the phone after the transfer arrived: attach it to its order."
msgstr "أكّدتَ الرصيد على الهاتف بعد وصول التحويل: ألحقه بطلبه."

#: src/Admin/Reasons.php:395
msgid "Personal transfer: no open order for it in the store"
msgstr "تحويل شخصي: لا طلب مفتوح له في المتجر"

#. translators: %s: reason code.
#: src/Admin/Reasons.php:400
#: src/Admin/Reasons.php:420
#, php-format
msgid "A reason this version does not know (%s): check the transfer in the wallet app."
msgstr "سبب لا تعرفه هذه النسخة (%s): راجع التحويل في تطبيق المحفظة."

#: src/Admin/Reasons.php:402
msgid "A new risk reason that this version does not know: check the transfer in the wallet app."
msgstr "سبب خطر جديد لا تعرفه هذه النسخة: راجع التحويل في تطبيق المحفظة."

#: src/Admin/Reasons.php:445
msgid "This transfer's message is suspected to be forged. Do not deliver the order until you have checked that the money arrived in the wallet app."
msgstr "يُشتبه أن رسالة هذا التحويل مزوّرة. لا تسلّم الطلب قبل أن تتأكد من وصول المال في تطبيق المحفظة."

#. translators: 1: smallest number of minutes, 2: largest number of minutes.
#: src/Admin/Settings.php:142
#, php-format
msgid "Enter the time to transfer as a whole number of minutes from %1$s to %2$s."
msgstr "اكتب مهلة التحويل عددًا صحيحًا من الدقائق من %1$s إلى %2$s."

#. translators: 1: smallest number of days, 2: largest number of days.
#: src/Admin/Settings.php:145
#, php-format
msgid "Enter how long unmatched transfers are kept as a whole number of days from %1$s to %2$s."
msgstr "اكتب مدة حفظ التحويلات بلا مطابقة عددًا صحيحًا من الأيام من %1$s إلى %2$s."

#: src/Admin/Settings.php:147
msgid "The minimum order total cannot be larger than the maximum."
msgstr "لا يمكن أن يكون الحد الأدنى لإجمالي الطلب أكبر من الحد الأقصى."

#: src/Admin/Settings.php:149
msgid "The settings were not saved. Check the values and try again."
msgstr "لم تُحفظ الإعدادات. راجع القيم وحاول مرة أخرى."

#: src/Admin/Settings.php:160
#: src/Admin/Settings.php:208
#: src/Admin/Wallets.php:375
#: src/Admin/Wallets.php:448
#: src/ConfigStore.php:436
msgid "These settings are set in wp-config.php (QERSH_WC_CONFIG) and cannot be changed here."
msgstr "هذه الإعدادات مضبوطة في wp-config.php (QERSH_WC_CONFIG) ولا يمكن تغييرها هنا."

#: src/Admin/Settings.php:168
msgid "Enter the order limits as amounts in pounds, such as 100 or 99.50, or leave them empty."
msgstr "اكتب حدود الطلب مبالغ بالجنيه، مثل 100 أو 99.50، أو اتركها فارغة."

#: src/Admin/Settings.php:194
msgid "The settings were saved."
msgstr "حُفظت الإعدادات."

#: src/Admin/Settings.php:218
msgid "Paste the settings file exported from Qersh for WooCommerce: a JSON object."
msgstr "الصق ملف الإعدادات المصدَّر من Qersh for WooCommerce: كائن JSON."

#: src/Admin/Settings.php:225
msgid "The settings were imported. Connection keys are never part of a settings file: link each new wallet's phone from its card."
msgstr "استُوردت الإعدادات. مفاتيح الربط لا تكون في ملف الإعدادات أبدًا: اربط هاتف كل محفظة جديدة من بطاقتها."

#: src/Admin/Status.php:65
msgid "Choose a wallet to check."
msgstr "اختر محفظة لفحصها."

#: src/Admin/Status.php:100
msgid "The fallback address works. Open your developer's link below on the wallet's phone so it sends there; it updates the same wallet and keeps the connection key. Then tap “Test connection”."
msgstr "العنوان البديل يعمل. افتح رابط مطوّرك أدناه على هاتف المحفظة ليرسل إليه؛ فهو يحدّث المحفظة نفسها ويُبقي مفتاح الربط. ثم اضغط «اختبار الربط»."

#: src/Admin/Status.php:104
msgid "your security plugin or firewall"
msgstr "إضافة الحماية أو الجدار الناري لديك"

#. translators: %s: name of a security plugin or firewall.
#: src/Admin/Status.php:106
#, php-format
msgid "Your store blocks REST requests from visitors, so the order page sends the transaction id through the plugin's fallback address. To use the normal one, allow the qersh routes in %s."
msgstr "يحجب متجرك طلبات REST من الزوار، فترسل صفحة الطلب رقم العملية عبر العنوان البديل للإضافة. ولتستعمل العنوان العادي اسمح بمسارات qersh في %s."

#: src/Admin/Status.php:126
msgid "Your store URL now"
msgstr "رابط متجرك الآن"

#: src/Admin/Status.php:128
msgid "The URL the phone last used"
msgstr "الرابط الذي استعمله الهاتف آخر مرة"

#: src/Admin/Status.php:130
msgid "The fallback URL (?wc-api=)"
msgstr "الرابط البديل (?wc-api=)"

#: src/Admin/Status.php:132
msgid "The order page's transaction id route"
msgstr "مسار رقم العملية في صفحة الطلب"

#: src/Admin/Status.php:134
msgid "Its fallback URL (?wc-api=)"
msgstr "رابطه البديل (?wc-api=)"

#: src/Admin/Status.php:152
msgid "Works: the plugin answered as expected."
msgstr "يعمل: أجابت الإضافة كما هو متوقع."

#: src/Admin/Status.php:153
msgid "Works: the plugin answered as expected (401, the test signature is invalid on purpose)."
msgstr "يعمل: أجابت الإضافة كما هو متوقع (401، لأن توقيع الاختبار غير صحيح عمدًا)."

#. translators: 1: name of a security plugin or firewall, 2: HTTP status code.
#: src/Admin/Status.php:157
#, php-format
msgid "Blocked: %1$s answers %2$s before the plugin sees the request. Allow the qersh routes (/wp-json/qersh/v1/ and ?wc-api=qersh) in its settings."
msgstr "محجوب: %1$s يرد بـ %2$s قبل أن يصل الطلب إلى الإضافة. اسمح بمسارات qersh (/wp-json/qersh/v1/ و?wc-api=qersh) في إعداداته."

#. translators: %s: HTTP status code.
#: src/Admin/Status.php:160
#, php-format
msgid "Blocked: a security plugin or firewall answers %s before the plugin sees the request. Allow the qersh routes (/wp-json/qersh/v1/ and ?wc-api=qersh) in it."
msgstr "محجوب: إضافة حماية أو جدار ناري يرد بـ %s قبل أن يصل الطلب إلى الإضافة. اسمح فيه بمسارات qersh (/wp-json/qersh/v1/ و?wc-api=qersh)."

#: src/Admin/Status.php:162
msgid "Cloudflare stops requests to this address with a challenge or a block, and the phone cannot pass it. In Cloudflare, add a rule that skips the challenge, Bot Fight Mode and the firewall for /wp-json/qersh/v1/ and ?wc-api=qersh."
msgstr "يوقف Cloudflare الطلبات إلى هذا العنوان بتحدٍّ أو حجب، ولا يستطيع الهاتف تجاوزه. أضف في Cloudflare قاعدة تتخطى التحدي وBot Fight Mode والجدار الناري لـ /wp-json/qersh/v1/ و?wc-api=qersh."

#. translators: 1: HTTP status code, 2: URL.
#: src/Admin/Status.php:165
#, php-format
msgid "This address redirects (%1$s) to %2$s, and the phone does not follow redirects. Open your new developer's link on the wallet's phone so it sends to the final address."
msgstr "هذا العنوان يعيد التوجيه (%1$s) إلى %2$s، والهاتف لا يتبع إعادة التوجيه. افتح رابط مطوّرك الجديد على هاتف المحفظة ليرسل إلى العنوان النهائي."

#. translators: %s: HTTP status code.
#: src/Admin/Status.php:168
#, php-format
msgid "This address answers %s with a web page instead of the plugin: plain permalinks, or an old domain. Open your new developer's link on the wallet's phone."
msgstr "هذا العنوان يرد بـ %s بصفحة ويب بدل الإضافة: روابط عادية أو نطاق قديم. افتح رابط مطوّرك الجديد على هاتف المحفظة."

#: src/Admin/Status.php:170
msgid "Your store is in maintenance mode, so it answers 503 to the phone. Transfers wait on the phone and arrive after the maintenance."
msgstr "متجرك في وضع الصيانة، فيرد على الهاتف بـ 503. تنتظر التحويلات على الهاتف وتصل بعد الصيانة."

#: src/Admin/Status.php:172
msgid "The plugin answers 503: WooCommerce is off, or the plugin's tables are missing."
msgstr "ترد الإضافة بـ 503: WooCommerce معطّل، أو جداول الإضافة ناقصة."

#: src/Admin/Status.php:174
msgid "The address answers, but the plugin's route is not there: a plugin removes REST routes, or the address belongs to another site."
msgstr "العنوان يرد، لكن مسار الإضافة غير موجود: إضافةٌ تزيل مسارات REST، أو العنوان يخص موقعًا آخر."

#: src/Admin/Status.php:176
msgid "The plugin answers, but does not know this wallet at this address: the address belongs to another site or another copy of the store."
