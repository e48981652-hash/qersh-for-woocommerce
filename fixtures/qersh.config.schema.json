{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qersh:receiver-config:1",
  "title": "Qersh receiver configuration",
  "type": "object",
  "required": [
    "endpoint",
    "keys",
    "tolerance_sec",
    "events",
    "matching",
    "dedup"
  ],
  "additionalProperties": false,
  "properties": {
    "endpoint": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\s][^\\s]*$",
          "default": "qersh"
        }
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^\\S{24,}$"
      },
      "description": "Connection keys, current first"
    },
    "tolerance_sec": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 300
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "transfer.received",
          "transfer.sent",
          "transfer.failed",
          "transfer.reversed",
          "transfer.updated",
          "message.unparsed",
          "device.heartbeat",
          "webhook.test",
          "subscription.limit_reached"
        ]
      },
      "default": [
        "transfer.received",
        "transfer.updated",
        "webhook.test"
      ]
    },
    "matching": {
      "type": "object",
      "required": [
        "late_window_min",
        "skew_min"
      ],
      "additionalProperties": false,
      "properties": {
        "late_window_min": {
          "type": "integer",
          "minimum": 0,
          "default": 120
        },
        "skew_min": {
          "type": "integer",
          "minimum": 0,
          "default": 10
        }
      }
    },
    "dedup": {
      "type": "object",
      "required": [
        "keep_days"
      ],
      "additionalProperties": false,
      "properties": {
        "keep_days": {
          "type": "integer",
          "minimum": 1,
          "default": 180
        }
      }
    }
  }
}
